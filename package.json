{
  "name": "unbarber-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --import=./seed --export-on-exit=./seed",
    "functions:build": "npm --prefix functions run build",
    "use:desa": "firebase use desa",
    "use:prd": "firebase use prd",
    "env:desa": "firebase apps:sdkconfig WEB --project desa --json | APP_ENV=desa node scripts/write-env.mjs .env.local",
    "deploy:desa": "firebase apps:sdkconfig WEB --project desa --json | APP_ENV=desa node scripts/write-env.mjs && npm run build && firebase deploy --project desa --only hosting:app,firestore,storage,functions",
    "rc:deploy:desa": "firebase deploy --project desa --only remoteconfig",
    "rc:deploy:prd": "firebase deploy --project prd --only remoteconfig"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "geofire-common": "^6.0.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
