{
  "name": "unbarber-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "emulators": "firebase emulators:start --import=./seed --export-on-exit=./seed",
    "functions:build": "npm --prefix functions run build",
    "deploy": "npm run build && firebase deploy --only hosting:app,firestore,storage,functions,remoteconfig",
    "deploy:hosting": "npm run build && firebase deploy --only hosting:app",
    "demo:build": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "geofire-common": "^6.0.0",
    "lucide-react": "^1.76.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
